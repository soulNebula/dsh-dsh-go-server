{
  "name": "dsh-remote-server",
  "version": "0.1.0",
  "description": "远程服务 —— 在 DSH 侧栏管理本机自建的 ds-harness-remote 服务端（启停、账号密码、设备）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulNebula/dsh-dsh-go-server.git"
  },
  "homepage": "https://github.com/soulNebula/dsh-dsh-go-server#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ds-harness-remote",
    "remote-server"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "tsdown": "0.22.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
